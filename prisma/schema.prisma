// ClientFlow database schema. TypeScript uses camelCase, PostgreSQL uses snake_case (spec §23.2).
// Check constraints, the audit append-only trigger and other rules Prisma cannot express
// are added as SQL inside the migration files.

generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  SALES_MANAGER
  SALES
  PM
  MEMBER
  FINANCE
  CLIENT
}

enum ContactLifecycle {
  LEAD
  CUSTOMER
}

enum ContactSource {
  REFERRAL
  WEBSITE
  SOCIAL
  EVENT
  OUTBOUND
  PARTNER
  OTHER
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model Agency {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String   @db.VarChar(200)
  slug            String   @unique @db.VarChar(80)
  defaultCurrency String   @default("EGP") @map("default_currency") @db.Char(3)
  timezone        String   @default("Africa/Cairo") @db.VarChar(64)
  /// Agency profile (FR-I09). Shown on proposals and in the client portal.
  contactEmail    String?  @map("contact_email") @db.VarChar(254)
  phone           String?  @db.VarChar(40)
  address         String?  @db.VarChar(500)
  /// Working days, 0 = Sunday … 6 = Saturday. Egypt default: Sunday to Thursday.
  workingDays     Int[]    @default([0, 1, 2, 3, 4]) @map("working_days")
  version         Int      @default(1)
  /// Last proposal reference number issued (P-0001, P-0002, ...). Incremented atomically.
  proposalSeq     Int      @default(0) @map("proposal_seq")
  /// Last invoice number issued (INV-0001, ...). Incremented atomically on issue.
  invoiceSeq      Int      @default(0) @map("invoice_seq")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       User[]
  invitations Invitation[]
  contacts    Contact[]
  activities  Activity[]
  auditEvents AuditEvent[]
  pipelines   Pipeline[]
  deals       Deal[]

  clientOrganizations ClientOrganization[]
  services            ServiceItem[]
  proposals           Proposal[]
  proposalVersions    ProposalVersion[]
  proposalReviews     ProposalReview[]
  projects            Project[]
  idempotencyRecords  IdempotencyRecord[]
  notifications       Notification[]
  importRuns          ImportRun[]

  @@map("agencies")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  agencyId     String    @map("agency_id") @db.Uuid
  emailNorm    String    @map("email_norm") @db.VarChar(254)
  name         String    @db.VarChar(120)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role
  /// Set for CLIENT users only (DB check): the organization whose published records they may see.
  clientOrgId  String?   @map("client_org_id") @db.Uuid
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  // Optimistic locking for team edits: stale PATCH requests get 409 (FR-D04 pattern).
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency              Agency                   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sessions            Session[]
  ownedContacts       Contact[]                @relation("ContactOwner")
  activities          Activity[]
  auditEvents         AuditEvent[]
  invitationsSent     Invitation[]             @relation("InvitedBy")
  invitationsAccepted Invitation[]             @relation("AcceptedUser")
  passwordResetTokens PasswordResetToken[]
  ownedDeals          Deal[]                   @relation("DealOwner")
  closedDeals         Deal[]                   @relation("DealClosedBy")
  clientOrg           ClientOrganization?      @relation("PortalUsers", fields: [clientOrgId], references: [id], onDelete: Restrict)
  proposalsCreated    Proposal[]               @relation("ProposalCreatedBy")
  versionsCreated     ProposalVersion[]        @relation("VersionCreatedBy")
  proposalReviews     ProposalReview[]
  managedProjects     Project[]                @relation("ProjectManager")
  createdProjects     Project[]                @relation("ProjectCreatedBy")
  projectMemberships  ProjectMember[]
  checklistDone       HandoffChecklistItem[]   @relation("ChecklistDoneBy")
  tasksAssigned       Task[]                   @relation("TaskAssignee")
  tasksCreated        Task[]                   @relation("TaskCreatedBy")
  timeEntries         TimeEntry[]              @relation("TimeEntries")
  filesUploaded       StoredFile[]             @relation("FilesUploaded")
  deliverablesCreated Deliverable[]            @relation("DeliverablesCreated")
  versionsSubmitted   DeliverableVersion[]     @relation("DeliverableVersionsCreated")
  versionsPublished   DeliverableVersion[]     @relation("DeliverableVersionsPublished")
  deliverableReviews  DeliverableReview[]      @relation("DeliverableReviews")
  projectShares       ProjectShare[]           @relation("ProjectSharesReceived")
  sharesGranted       ProjectShare[]           @relation("ProjectSharesGranted")
  sharesRevoked       ProjectShare[]           @relation("ProjectSharesRevoked")
  changesRequested    ChangeRequest[]          @relation("ChangesRequested")
  changeVersionsMade  ChangeVersion[]          @relation("ChangeVersionsCreated")
  changeVersionsOk    ChangeVersion[]          @relation("ChangeVersionsApproved")
  changeVersionsSent  ChangeVersion[]          @relation("ChangeVersionsSent")
  changeDecisions     ChangeDecision[]         @relation("ChangeDecisions")
  comments            ProjectComment[]         @relation("CommentsWritten")
  invoicesCreated     Invoice[]                @relation("InvoicesCreated")
  invoicesIssued      Invoice[]                @relation("InvoicesIssued")
  invoicesVoided      Invoice[]                @relation("InvoicesVoided")
  paymentsRecorded    Payment[]                @relation("PaymentsRecorded")
  costRates           CostRate[]               @relation("CostRates")
  costRatesSet        CostRate[]               @relation("CostRatesSet")
  notifications       Notification[]           @relation("NotificationRecipient")
  notificationPrefs   NotificationPreference[]
  importRuns          ImportRun[]              @relation("ImportRuns")

  @@unique([agencyId, emailNorm])
  // Target of composite foreign keys that keep nested rows inside the same agency (spec §8.2).
  @@unique([agencyId, id])
  @@index([emailNorm])
  @@index([clientOrgId])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Contact {
  id           String           @id @default(uuid(7)) @db.Uuid
  agencyId     String           @map("agency_id") @db.Uuid
  ownerId      String           @map("owner_id") @db.Uuid
  fullName     String           @map("full_name") @db.VarChar(200)
  emailNorm    String?          @map("email_norm") @db.VarChar(254)
  phone        String?          @db.VarChar(40)
  phoneNorm    String?          @map("phone_norm") @db.VarChar(20)
  companyName  String?          @map("company_name") @db.VarChar(200)
  /// The customer company this person belongs to; proposals are published to its portal users.
  clientOrgId  String?          @map("client_org_id") @db.Uuid
  lifecycle    ContactLifecycle @default(LEAD)
  source       ContactSource?
  nextActionAt DateTime?        @map("next_action_at") @db.Timestamptz(3)
  notes        String?          @db.VarChar(5000)
  /// When the lead became a customer (FR-C07). Same row, same ID.
  convertedAt  DateTime?        @map("converted_at") @db.Timestamptz(3)
  /// Set when the contact came from a CSV import (FR-C10), so the import can be undone.
  importRunId  String?          @map("import_run_id") @db.Uuid
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz(3)
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency    Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  // Composite FK: the owner must belong to the same agency as the contact.
  owner     User                @relation("ContactOwner", fields: [agencyId, ownerId], references: [agencyId, id], onDelete: Restrict)
  deals     Deal[]
  /// Plain FK (nullable); the service checks that the organization is in the same agency.
  clientOrg ClientOrganization? @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  projects  Project[]
  importRun ImportRun?          @relation(fields: [importRunId], references: [id], onDelete: Restrict)

  // Target of the deals composite FK (deal and contact in the same agency).
  @@unique([agencyId, id])
  @@index([agencyId, ownerId, createdAt(sort: Desc)])
  @@index([agencyId, nextActionAt])
  @@index([agencyId, createdAt(sort: Desc)])
  @@index([agencyId, emailNorm])
  @@index([agencyId, phoneNorm])
  @@index([importRunId])
  @@map("contacts")
}

model Activity {
  id         String   @id @default(uuid(7)) @db.Uuid
  agencyId   String   @map("agency_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(60)
  summary    String   @db.VarChar(500)
  /// Free text for notes and logged calls/emails/meetings (FR-C08). Rendered as text only.
  body       String?  @db.VarChar(5000)
  /// When the interaction happened (may be earlier than when it was logged).
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([agencyId, entityType, entityId, occurredAt(sort: Desc)])
  @@map("activities")
}

model AuditEvent {
  id               String       @id @default(uuid(7)) @db.Uuid
  agencyId         String?      @map("agency_id") @db.Uuid
  actorId          String?      @map("actor_id") @db.Uuid
  action           String       @db.VarChar(80)
  targetType       String?      @map("target_type") @db.VarChar(40)
  targetId         String?      @map("target_id") @db.Uuid
  outcome          AuditOutcome
  requestId        String?      @map("request_id") @db.VarChar(64)
  metadataRedacted Json?        @map("metadata_redacted")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_events")
}

// One-time staff invitation (FR-I04, FR-I05). Only the SHA-256 of the token is stored.
// State is derived: ACCEPTED (accepted_at), REVOKED (revoked_at), EXPIRED (expires_at past), else PENDING.
model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  agencyId       String    @map("agency_id") @db.Uuid
  emailNorm      String    @map("email_norm") @db.VarChar(254)
  role           Role
  /// Required for CLIENT (portal) invitations, empty for staff invitations (DB check).
  clientOrgId    String?   @map("client_org_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  invitedById    String    @map("invited_by_id") @db.Uuid
  acceptedUserId String?   @map("accepted_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency       Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  invitedBy    User                @relation("InvitedBy", fields: [agencyId, invitedById], references: [agencyId, id], onDelete: Restrict)
  acceptedUser User?               @relation("AcceptedUser", fields: [acceptedUserId], references: [id], onDelete: Restrict)
  clientOrg    ClientOrganization? @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt(sort: Desc)])
  @@map("invitations")
}

// Single-use password reset token (FR-I06). Hash only, short expiry.
model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// One pipeline per agency in v1, with stable stage IDs (FR-D02). Stage names and order can change
// without touching deals, because deals point at stage IDs.
model Pipeline {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  name      String   @db.VarChar(120)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  stages PipelineStage[]
  deals  Deal[]

  @@unique([agencyId, id])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid(7)) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  name       String   @db.VarChar(80)
  position   Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  deals    Deal[]

  @@unique([pipelineId, position])
  // Target of the deals composite FK: a deal's stage must belong to the deal's pipeline.
  @@unique([pipelineId, id])
  @@map("pipeline_stages")
}

// Status (OPEN/WON/LOST) is separate from stage (spec §8.2, §9). Amounts are integer minor
// units with an ISO currency: never floats, never summed across currencies (FR-F10).
model Deal {
  id                        String     @id @default(uuid(7)) @db.Uuid
  agencyId                  String     @map("agency_id") @db.Uuid
  contactId                 String     @map("contact_id") @db.Uuid
  ownerId                   String     @map("owner_id") @db.Uuid
  pipelineId                String     @map("pipeline_id") @db.Uuid
  stageId                   String     @map("stage_id") @db.Uuid
  title                     String     @db.VarChar(200)
  amountMinor               BigInt     @default(0) @map("amount_minor")
  currency                  String     @db.Char(3)
  status                    DealStatus @default(OPEN)
  expectedCloseOn           DateTime?  @map("expected_close_on") @db.Date
  nextStep                  String?    @map("next_step") @db.VarChar(300)
  nextStepAt                DateTime?  @map("next_step_at") @db.Timestamptz(3)
  closedAt                  DateTime?  @map("closed_at") @db.Timestamptz(3)
  closedById                String?    @map("closed_by_id") @db.Uuid
  lostReason                String?    @map("lost_reason") @db.VarChar(500)
  /// WON without an accepted proposal needs a documented, authorized override (FR-D05).
  wonOverrideReason         String?    @map("won_override_reason") @db.VarChar(500)
  archivedAt                DateTime?  @map("archived_at") @db.Timestamptz(3)
  /// The client-accepted proposal version that won this deal (FR-D05, FR-Q10).
  acceptedProposalVersionId String?    @unique @map("accepted_proposal_version_id") @db.Uuid
  /// Set when the deal came from a CSV import (FR-C10).
  importRunId               String?    @map("import_run_id") @db.Uuid
  version                   Int        @default(1)
  createdAt                 DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency                  Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  contact                 Contact          @relation(fields: [agencyId, contactId], references: [agencyId, id], onDelete: Restrict)
  owner                   User             @relation("DealOwner", fields: [agencyId, ownerId], references: [agencyId, id], onDelete: Restrict)
  pipeline                Pipeline         @relation(fields: [agencyId, pipelineId], references: [agencyId, id], onDelete: Restrict)
  stage                   PipelineStage    @relation(fields: [pipelineId, stageId], references: [pipelineId, id], onDelete: Restrict)
  /// Plain FK: an optional composite relation cannot include the required agency_id. The closer
  /// is always the acting user, whose agency the service checks.
  closedBy                User?            @relation("DealClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  acceptedProposalVersion ProposalVersion? @relation("DealAcceptedVersion", fields: [acceptedProposalVersionId], references: [id], onDelete: Restrict)
  proposals               Proposal[]
  project                 Project?
  importRun               ImportRun?       @relation(fields: [importRunId], references: [id], onDelete: Restrict)

  // Target of the proposals composite FK.
  @@unique([agencyId, id])
  @@index([agencyId, status, stageId])
  @@index([agencyId, ownerId, status])
  @@index([agencyId, contactId])
  @@index([agencyId, nextStepAt])
  @@index([importRunId])
  @@map("deals")
}

// M4: client organizations, service catalog and proposals.

// A customer company (spec §8.1 client_organizations). Portal users belong to exactly one.
model ClientOrganization {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  name       String    @db.VarChar(200)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency      Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  contacts    Contact[]
  portalUsers User[]       @relation("PortalUsers")
  invitations Invitation[]
  proposals   Proposal[]
  projects    Project[]
  invoices    Invoice[]

  @@unique([agencyId, id])
  @@index([agencyId, name])
  @@map("client_organizations")
}

// Service catalog entry (FR-Q01). Proposal items copy name and price, so edits here never change
// a proposal that was already written.
model ServiceItem {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  name        String    @db.VarChar(160)
  description String?   @db.VarChar(2000)
  unit        String    @db.VarChar(40)
  rateMinor   BigInt    @map("rate_minor")
  currency    String    @db.Char(3)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  items  ProposalItem[]

  @@index([agencyId, archivedAt, name])
  @@map("service_catalog")
}

enum ProposalStatus {
  DRAFT
  IN_REVIEW
  APPROVED_INTERNAL
  SENT
  ACCEPTED
  REJECTED
  CHANGES_REQUESTED
  SUPERSEDED
}

// One proposal per offer on a deal. Content lives in numbered versions (FR-Q04).
model Proposal {
  id               String         @id @default(uuid(7)) @db.Uuid
  agencyId         String         @map("agency_id") @db.Uuid
  dealId           String         @map("deal_id") @db.Uuid
  /// Agency-wide reference number, shown as P-0001 (FR-Q06).
  number           Int
  /// Mirrors the status of the latest version, for lists and filters.
  status           ProposalStatus @default(DRAFT)
  currentVersionNo Int            @default(1) @map("current_version_no")
  /// The deal contact's organization when a version was last sent; portal access follows it.
  clientOrgId      String?        @map("client_org_id") @db.Uuid
  createdById      String         @map("created_by_id") @db.Uuid
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency    Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  deal      Deal                @relation(fields: [agencyId, dealId], references: [agencyId, id], onDelete: Restrict)
  createdBy User                @relation("ProposalCreatedBy", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  clientOrg ClientOrganization? @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  versions  ProposalVersion[]

  @@unique([agencyId, number])
  @@unique([agencyId, id])
  @@index([agencyId, status, updatedAt(sort: Desc)])
  @@index([agencyId, dealId])
  @@index([clientOrgId, status])
  @@map("proposals")
}

// An immutable snapshot once it leaves DRAFT (FR-Q04): a DB trigger refuses content changes and
// item changes on non-draft versions. Totals are computed on the server in integer minor units.
model ProposalVersion {
  id            String         @id @default(uuid(7)) @db.Uuid
  agencyId      String         @map("agency_id") @db.Uuid
  proposalId    String         @map("proposal_id") @db.Uuid
  versionNo     Int            @map("version_no")
  status        ProposalStatus @default(DRAFT)
  title         String         @db.VarChar(200)
  summary       String?        @db.VarChar(5000)
  inclusions    String?        @db.VarChar(5000)
  exclusions    String?        @db.VarChar(5000)
  assumptions   String?        @db.VarChar(5000)
  milestones    String?        @db.VarChar(5000)
  paymentTerms  String?        @map("payment_terms") @db.VarChar(2000)
  terms         String?        @db.VarChar(10000)
  /// Staff-only. Never serialized to the client portal or the client print view.
  internalNotes String?        @map("internal_notes") @db.VarChar(5000)
  currency      String         @db.Char(3)
  /// Valid through the end of this day in the agency timezone (FR-Q08).
  expiresOn     DateTime       @map("expires_on") @db.Date
  /// Discount and tax in basis points (1400 = 14.00%), applied to the whole proposal.
  discountBp    Int            @default(0) @map("discount_bp")
  taxRateBp     Int            @default(1400) @map("tax_rate_bp")
  taxLabel      String         @default("VAT") @map("tax_label") @db.VarChar(40)
  subtotalMinor BigInt         @default(0) @map("subtotal_minor")
  discountMinor BigInt         @default(0) @map("discount_minor")
  taxMinor      BigInt         @default(0) @map("tax_minor")
  totalMinor    BigInt         @default(0) @map("total_minor")
  /// SHA-256 of the client-visible content, fixed when the version leaves DRAFT (FR-Q09).
  contentHash   String?        @map("content_hash") @db.Char(64)
  submittedAt   DateTime?      @map("submitted_at") @db.Timestamptz(3)
  approvedAt    DateTime?      @map("approved_at") @db.Timestamptz(3)
  sentAt        DateTime?      @map("sent_at") @db.Timestamptz(3)
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdById   String         @map("created_by_id") @db.Uuid
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency       Agency           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  proposal     Proposal         @relation(fields: [agencyId, proposalId], references: [agencyId, id], onDelete: Restrict)
  createdBy    User             @relation("VersionCreatedBy", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  items        ProposalItem[]
  reviews      ProposalReview[]
  acceptedDeal Deal?            @relation("DealAcceptedVersion")
  project      Project?

  @@unique([proposalId, versionNo])
  @@unique([agencyId, id])
  @@index([agencyId, status])
  @@map("proposal_versions")
}

model ProposalItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  versionId      String  @map("version_id") @db.Uuid
  position       Int
  /// Where the line came from, if anywhere. The line keeps its own copy of name and price.
  serviceId      String? @map("service_id") @db.Uuid
  name           String  @db.VarChar(200)
  description    String? @db.VarChar(2000)
  unit           String  @db.VarChar(40)
  /// Quantity in hundredths (150 = 1.5), so no binary floats are involved.
  quantityCenti  Int     @map("quantity_centi")
  unitPriceMinor BigInt  @map("unit_price_minor")
  lineTotalMinor BigInt  @map("line_total_minor")

  version ProposalVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  service ServiceItem?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([versionId, position])
  @@map("proposal_items")
}

enum ReviewKind {
  INTERNAL
  CLIENT
}

enum ReviewDecision {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
  SENT
  ACCEPTED
  REJECTED
}

// Who decided what on which version, and when (spec §8.1 proposal_reviews). One client decision
// per version (T-PROP-03), and it keeps the hash of the terms that were shown (FR-Q09).
model ProposalReview {
  id          String         @id @default(uuid(7)) @db.Uuid
  agencyId    String         @map("agency_id") @db.Uuid
  versionId   String         @map("version_id") @db.Uuid
  actorId     String         @map("actor_id") @db.Uuid
  kind        ReviewKind
  decision    ReviewDecision
  comment     String?        @db.VarChar(2000)
  contentHash String?        @map("content_hash") @db.Char(64)
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  agency  Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  version ProposalVersion @relation(fields: [agencyId, versionId], references: [agencyId, id], onDelete: Restrict)
  actor   User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([versionId, occurredAt])
  @@map("proposal_reviews")
}

// M6: projects, membership, milestones, handoff checklist and stored idempotency results.

enum ProjectState {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectRole {
  MANAGER
  MEMBER
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

// A delivery project (spec §8.1 projects). Created by the won-deal handoff (one project per deal,
// unique link) or manually by Owner/Admin/PM. The scope baseline is the accepted proposal
// version, which is immutable (ADR-030), so the project points at it instead of copying it.
model Project {
  id                String       @id @default(uuid(7)) @db.Uuid
  agencyId          String       @map("agency_id") @db.Uuid
  title             String       @db.VarChar(200)
  state             ProjectState @default(PLANNED)
  /// Set when the project came from a won deal. At most one project per deal.
  dealId            String?      @unique @map("deal_id") @db.Uuid
  /// The client-accepted proposal version used as the scope baseline (FR-Q10).
  baselineVersionId String?      @unique @map("baseline_version_id") @db.Uuid
  contactId         String?      @map("contact_id") @db.Uuid
  clientOrgId       String?      @map("client_org_id") @db.Uuid
  managerId         String       @map("manager_id") @db.Uuid
  startOn           DateTime?    @map("start_on") @db.Date
  dueOn             DateTime?    @map("due_on") @db.Date
  /// Budget baseline excluding tax, in minor units of `currency` (ADR-039).
  budgetMinor       BigInt       @default(0) @map("budget_minor")
  currency          String       @db.Char(3)
  createdById       String       @map("created_by_id") @db.Uuid
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  agency              Agency                 @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  manager             User                   @relation("ProjectManager", fields: [agencyId, managerId], references: [agencyId, id], onDelete: Restrict)
  createdBy           User                   @relation("ProjectCreatedBy", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  /// Plain FKs (nullable); the service checks they belong to the same agency (ADR-025 pattern).
  deal                Deal?                  @relation(fields: [dealId], references: [id], onDelete: Restrict)
  baselineVersion     ProposalVersion?       @relation(fields: [baselineVersionId], references: [id], onDelete: Restrict)
  contact             Contact?               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  clientOrg           ClientOrganization?    @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  members             ProjectMember[]
  milestones          ProjectMilestone[]
  checklist           HandoffChecklistItem[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  files               StoredFile[]
  deliverables        Deliverable[]
  deliverableVersions DeliverableVersion[]
  shares              ProjectShare[]
  changeRequests      ChangeRequest[]
  changeVersions      ChangeVersion[]
  comments            ProjectComment[]
  invoices            Invoice[]

  @@unique([agencyId, id])
  @@index([agencyId, state, updatedAt(sort: Desc)])
  @@index([agencyId, managerId])
  @@map("projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  agencyId  String      @map("agency_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole @default(MEMBER)
  addedAt   DateTime    @default(now()) @map("added_at") @db.Timestamptz(3)

  project Project @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Cascade)
  user    User    @relation(fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([agencyId, userId])
  @@map("project_members")
}

model ProjectMilestone {
  id        String          @id @default(uuid(7)) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  agencyId  String          @map("agency_id") @db.Uuid
  title     String          @db.VarChar(200)
  dueOn     DateTime?       @map("due_on") @db.Date
  status    MilestoneStatus @default(PLANNED)
  sequence  Int
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  project      Project       @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Cascade)
  tasks        Task[]
  deliverables Deliverable[]

  @@unique([projectId, sequence])
  @@index([agencyId, dueOn])
  @@map("project_milestones")
}

model HandoffChecklistItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  agencyId  String    @map("agency_id") @db.Uuid
  label     String    @db.VarChar(200)
  sequence  Int
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  doneById  String?   @map("done_by_id") @db.Uuid

  project Project @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Cascade)
  doneBy  User?   @relation("ChecklistDoneBy", fields: [doneById], references: [id], onDelete: Restrict)

  @@unique([projectId, sequence])
  @@map("handoff_checklist_items")
}

// The stored result of an idempotent request (spec §11.6): a retry with the same key and the same
// request returns the same result; the same key with a different request is refused.
model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  scope       String   @db.VarChar(60)
  key         String   @db.Uuid
  requestHash String   @map("request_hash") @db.Char(64)
  resultId    String   @map("result_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([agencyId, scope, key])
  @@map("idempotency_records")
}

// M7: tasks, time entries, private files, deliverables and portal project sharing.

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A unit of delivery work inside a project (FR-P05). The milestone and assignee are plain FKs
// (nullable, ADR-025); the service checks they belong to the same project and agency.
model Task {
  id              String       @id @default(uuid(7)) @db.Uuid
  agencyId        String       @map("agency_id") @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  milestoneId     String?      @map("milestone_id") @db.Uuid
  assigneeId      String?      @map("assignee_id") @db.Uuid
  createdById     String       @map("created_by_id") @db.Uuid
  title           String       @db.VarChar(200)
  description     String?      @db.VarChar(5000)
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueOn           DateTime?    @map("due_on") @db.Date
  estimateMinutes Int?         @map("estimate_minutes")
  /// Set when the task reaches DONE, cleared when it leaves DONE (DB check).
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  /// FR-S05: original scope, an accepted change of this project (DB trigger), or a documented exception.
  scope           TaskScope    @default(BASELINE)
  changeRequestId String?      @map("change_request_id") @db.Uuid
  /// Why work outside the agreed scope was allowed (required for EXCEPTION).
  scopeNote       String?      @map("scope_note") @db.VarChar(500)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  changeRequest ChangeRequest?    @relation(fields: [changeRequestId], references: [id], onDelete: Restrict)
  project       Project           @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  milestone     ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  assignee      User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("TaskCreatedBy", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  /// Tasks this task waits for (FR-P06).
  blockedBy     TaskDependency[]  @relation("DependentTask")
  /// Tasks waiting for this one.
  blocking      TaskDependency[]  @relation("BlockingTask")
  timeEntries   TimeEntry[]

  @@unique([agencyId, id])
  // Target of the dependency and time entry FKs: both tasks / the task stay in one project.
  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([agencyId, assigneeId, status])
  @@index([agencyId, dueOn])
  @@map("tasks")
}

// "task waits for depends_on" (FR-P06). Both tasks are in the same project (composite FKs); the
// service refuses cycles under a project row lock, and the DB refuses self-links.
model TaskDependency {
  projectId   String   @map("project_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  dependsOnId String   @map("depends_on_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task      Task @relation("DependentTask", fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  dependsOn Task @relation("BlockingTask", fields: [projectId, dependsOnId], references: [projectId, id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

// Time worked on a task (FR-P08). Cost rates arrive with finance (M9, FR-F06), so none is stored.
model TimeEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  workedOn  DateTime @map("worked_on") @db.Date
  minutes   Int
  billable  Boolean  @default(true)
  /// Internal only: never shown in the client portal.
  note      String?  @db.VarChar(1000)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  task    Task    @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Restrict)
  user    User    @relation("TimeEntries", fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)

  @@index([taskId])
  @@index([agencyId, projectId, workedOn])
  @@index([agencyId, userId, workedOn])
  @@map("time_entries")
}

enum FileScanStatus {
  /// Stored but not checked yet. Never downloadable or publishable.
  PENDING
  CLEAN
  /// A scanner flagged it after storage. Never downloadable or publishable.
  QUARANTINED
}

// Metadata of a private uploaded file (spec §8.1 files, SEC-12). The bytes live in storage under
// a random key, encrypted; the original name is kept for display only and never used as a path.
model StoredFile {
  id           String         @id @default(uuid(7)) @db.Uuid
  agencyId     String         @map("agency_id") @db.Uuid
  projectId    String         @map("project_id") @db.Uuid
  uploadedById String         @map("uploaded_by_id") @db.Uuid
  storageKey   String         @unique @map("storage_key") @db.VarChar(100)
  /// Sanitized display name, e.g. "Homepage design.pdf".
  originalName String         @map("original_name") @db.VarChar(255)
  extension    String         @db.VarChar(10)
  /// Decided by the server from the allowlist, never taken from the browser.
  mimeType     String         @map("mime_type") @db.VarChar(120)
  sizeBytes    Int            @map("size_bytes")
  /// SHA-256 of the plain content.
  sha256       String         @db.Char(64)
  scanStatus   FileScanStatus @default(PENDING) @map("scan_status")
  scanDetail   String?        @map("scan_detail") @db.VarChar(200)
  scannedAt    DateTime?      @map("scanned_at") @db.Timestamptz(3)
  /// AES-256-GCM nonce and tag used by the local encrypted storage adapter.
  encIv        Bytes?         @map("enc_iv")
  encTag       Bytes?         @map("enc_tag")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  project            Project             @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  uploadedBy         User                @relation("FilesUploaded", fields: [agencyId, uploadedById], references: [agencyId, id], onDelete: Restrict)
  deliverableVersion DeliverableVersion?

  @@unique([agencyId, id])
  // Target of the deliverable version FK: a version's file must be in the deliverable's project.
  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("files")
}

enum DeliverableStatus {
  DRAFT
  READY
  PUBLISHED
  REVISION_REQUESTED
  APPROVED
  ARCHIVED
}

enum DeliverableDecision {
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

// Something the client reviews (FR-S06). Private until the project manager publishes a version.
model Deliverable {
  id               String            @id @default(uuid(7)) @db.Uuid
  agencyId         String            @map("agency_id") @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  milestoneId      String?           @map("milestone_id") @db.Uuid
  title            String            @db.VarChar(200)
  description      String?           @db.VarChar(2000)
  status           DeliverableStatus @default(DRAFT)
  /// The client is asked to decide by the end of this day, agency timezone (FR-S09).
  reviewDueOn      DateTime?         @map("review_due_on") @db.Date
  currentVersionNo Int               @default(0) @map("current_version_no")
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  createdById      String            @map("created_by_id") @db.Uuid
  version          Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project              @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  milestone ProjectMilestone?    @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  createdBy User                 @relation("DeliverablesCreated", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  versions  DeliverableVersion[]

  @@unique([agencyId, id])
  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([agencyId, status, reviewDueOn])
  @@map("deliverables")
}

// One file submitted for review (FR-S08). Immutable once published (DB trigger).
model DeliverableVersion {
  id            String    @id @default(uuid(7)) @db.Uuid
  agencyId      String    @map("agency_id") @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  deliverableId String    @map("deliverable_id") @db.Uuid
  versionNo     Int       @map("version_no")
  fileId        String    @map("file_id") @db.Uuid
  note          String?   @db.VarChar(2000)
  /// Copy of the file hash when the version was made: what the client reviews.
  fileSha256    String    @map("file_sha256") @db.Char(64)
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById String?   @map("published_by_id") @db.Uuid

  project     Project            @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  deliverable Deliverable        @relation(fields: [projectId, deliverableId], references: [projectId, id], onDelete: Restrict)
  file        StoredFile         @relation(fields: [projectId, fileId], references: [projectId, id], onDelete: Restrict)
  createdBy   User               @relation("DeliverableVersionsCreated", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  publishedBy User?              @relation("DeliverableVersionsPublished", fields: [publishedById], references: [id], onDelete: Restrict)
  review      DeliverableReview?

  @@unique([deliverableId, versionNo])
  @@unique([agencyId, id])
  // A file is reviewed in at most one version.
  @@unique([projectId, fileId])
  @@map("deliverable_versions")
}

// The client's decision on a published version (FR-S07, US-13). One per version; append-only.
model DeliverableReview {
  id         String              @id @default(uuid(7)) @db.Uuid
  agencyId   String              @map("agency_id") @db.Uuid
  versionId  String              @map("version_id") @db.Uuid
  actorId    String              @map("actor_id") @db.Uuid
  decision   DeliverableDecision
  reason     String?             @db.VarChar(2000)
  fileSha256 String              @map("file_sha256") @db.Char(64)
  occurredAt DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)

  version DeliverableVersion @relation(fields: [agencyId, versionId], references: [agencyId, id], onDelete: Restrict)
  actor   User               @relation("DeliverableReviews", fields: [agencyId, actorId], references: [agencyId, id], onDelete: Restrict)

  // One client decision per version.
  @@unique([agencyId, versionId])
  @@map("deliverable_reviews")
}

// A project explicitly shared with one client portal user (FR-X01, spec §8.1 client_project_shares).
// A DB trigger checks that the user is a CLIENT of the project's client organization.
model ProjectShare {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  sharedById  String    @map("shared_by_id") @db.Uuid
  sharedAt    DateTime  @default(now()) @map("shared_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  project   Project @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  user      User    @relation("ProjectSharesReceived", fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)
  sharedBy  User    @relation("ProjectSharesGranted", fields: [agencyId, sharedById], references: [agencyId, id], onDelete: Restrict)
  revokedBy User?   @relation("ProjectSharesRevoked", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([agencyId, userId])
  @@map("project_portal_shares")
}

// M8: scope changes (change requests with versions and client decisions) and client comments.

enum TaskScope {
  /// Part of the accepted proposal baseline.
  BASELINE
  /// Extra work from an accepted change request.
  CHANGE
  /// Extra work allowed without a change, with a written reason (FR-S05).
  EXCEPTION
}

enum ChangeStatus {
  REQUESTED
  ESTIMATING
  IN_REVIEW
  AWAITING_CLIENT
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ChangeVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED_INTERNAL
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
  WITHDRAWN
}

enum ChangeDecisionKind {
  ACCEPTED
  REJECTED
}

// A requested change to a project's agreed scope (spec §8.1 change_requests, FR-S01). The
// estimate lives in numbered versions; only a client-accepted version changes the baseline.
model ChangeRequest {
  id                String       @id @default(uuid(7)) @db.Uuid
  agencyId          String       @map("agency_id") @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  /// Per-project reference, shown as CR-1, CR-2, ...
  number            Int
  title             String       @db.VarChar(200)
  /// What should change, in the requester's words.
  description       String       @db.VarChar(5000)
  justification     String?      @db.VarChar(2000)
  status            ChangeStatus @default(REQUESTED)
  currentVersionNo  Int          @default(0) @map("current_version_no")
  requestedById     String       @map("requested_by_id") @db.Uuid
  requestedByClient Boolean      @default(false) @map("requested_by_client")
  /// The version the client accepted (set once, with the baseline update).
  acceptedVersionId String?      @unique @map("accepted_version_id") @db.Uuid
  withdrawnReason   String?      @map("withdrawn_reason") @db.VarChar(500)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project         Project         @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  requestedBy     User            @relation("ChangesRequested", fields: [agencyId, requestedById], references: [agencyId, id], onDelete: Restrict)
  acceptedVersion ChangeVersion?  @relation("AcceptedChangeVersion", fields: [acceptedVersionId], references: [id], onDelete: Restrict)
  versions        ChangeVersion[]
  tasks           Task[]

  @@unique([projectId, number])
  @@unique([agencyId, id])
  @@unique([projectId, id])
  @@index([projectId, status])
  @@map("change_requests")
}

// One estimate of a change (spec §8.1 change_versions). Content is frozen once sent (DB trigger).
// Money in minor units of the project currency; the price excludes tax.
model ChangeVersion {
  id                String              @id @default(uuid(7)) @db.Uuid
  agencyId          String              @map("agency_id") @db.Uuid
  projectId         String              @map("project_id") @db.Uuid
  changeRequestId   String              @map("change_request_id") @db.Uuid
  versionNo         Int                 @map("version_no")
  status            ChangeVersionStatus @default(DRAFT)
  /// The scope delta: what is added, changed or removed.
  scope             String              @default("") @db.VarChar(5000)
  /// One work item per line; each becomes a task when the change is accepted.
  workItems         String?             @map("work_items") @db.VarChar(5000)
  /// Internal effort estimate. Never shown to the client.
  estimateMinutes   Int?                @map("estimate_minutes")
  priceMinor        BigInt              @default(0) @map("price_minor")
  currency          String              @db.Char(3)
  taxRateBp         Int                 @default(1400) @map("tax_rate_bp")
  taxMinor          BigInt              @default(0) @map("tax_minor")
  totalMinor        BigInt              @default(0) @map("total_minor")
  /// The project's new due date if the change moves it.
  newDueOn          DateTime?           @map("new_due_on") @db.Date
  /// SHA-256 of the client-visible content, fixed when the version is sent.
  contentHash       String?             @map("content_hash") @db.Char(64)
  submittedAt       DateTime?           @map("submitted_at") @db.Timestamptz(3)
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedById      String?             @map("approved_by_id") @db.Uuid
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  sentById          String?             @map("sent_by_id") @db.Uuid
  /// Project budget and due date just before and after acceptance (traceability, T-SCOPE-02).
  budgetBeforeMinor BigInt?             @map("budget_before_minor")
  budgetAfterMinor  BigInt?             @map("budget_after_minor")
  dueBefore         DateTime?           @map("due_before") @db.Date
  createdById       String              @map("created_by_id") @db.Uuid
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project         @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  changeRequest  ChangeRequest   @relation(fields: [projectId, changeRequestId], references: [projectId, id], onDelete: Restrict)
  createdBy      User            @relation("ChangeVersionsCreated", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  approvedBy     User?           @relation("ChangeVersionsApproved", fields: [approvedById], references: [id], onDelete: Restrict)
  sentBy         User?           @relation("ChangeVersionsSent", fields: [sentById], references: [id], onDelete: Restrict)
  decision       ChangeDecision?
  acceptedChange ChangeRequest?  @relation("AcceptedChangeVersion")

  @@unique([changeRequestId, versionNo])
  @@unique([agencyId, id])
  @@map("change_versions")
}

// The client's decision on a sent version (FR-S03, FR-S04). One per version; append-only.
model ChangeDecision {
  id          String             @id @default(uuid(7)) @db.Uuid
  agencyId    String             @map("agency_id") @db.Uuid
  versionId   String             @map("version_id") @db.Uuid
  actorId     String             @map("actor_id") @db.Uuid
  decision    ChangeDecisionKind
  reason      String?            @db.VarChar(2000)
  contentHash String             @map("content_hash") @db.Char(64)
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  version ChangeVersion @relation(fields: [agencyId, versionId], references: [agencyId, id], onDelete: Restrict)
  actor   User          @relation("ChangeDecisions", fields: [agencyId, actorId], references: [agencyId, id], onDelete: Restrict)

  @@unique([agencyId, versionId])
  @@map("change_decisions")
}

// A comment on a deliverable or change, by the project team or the client (FR-X08). Edits keep
// the earlier text in comment revisions; deleting hides the text but keeps the history.
model ProjectComment {
  id         String    @id @default(uuid(7)) @db.Uuid
  agencyId   String    @map("agency_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  /// "deliverable" or "change" (DB check); the service checks the item is in the project.
  entityType String    @map("entity_type") @db.VarChar(20)
  entityId   String    @map("entity_id") @db.Uuid
  authorId   String    @map("author_id") @db.Uuid
  body       String    @db.VarChar(2000)
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project                  @relation(fields: [agencyId, projectId], references: [agencyId, id], onDelete: Restrict)
  author    User                     @relation("CommentsWritten", fields: [agencyId, authorId], references: [agencyId, id], onDelete: Restrict)
  revisions ProjectCommentRevision[]

  @@index([projectId, entityType, entityId, createdAt])
  @@map("project_comments")
}

// Earlier text of an edited or deleted comment (append-only).
model ProjectCommentRevision {
  id         String   @id @default(uuid(7)) @db.Uuid
  commentId  String   @map("comment_id") @db.Uuid
  body       String   @db.VarChar(2000)
  /// When this text was replaced.
  replacedAt DateTime @default(now()) @map("replaced_at") @db.Timestamptz(3)

  comment ProjectComment @relation(fields: [commentId], references: [id], onDelete: Restrict)

  @@index([commentId, replacedAt])
  @@map("project_comment_revisions")
}

// M9: invoice tracking (no payment processing), payments and internal cost rates.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentKind {
  PAYMENT
  /// Undoes one earlier payment (mistakes are reversed, never edited).
  REVERSAL
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum InvoiceLineSource {
  MILESTONE
  CHANGE
  OTHER
}

// An invoice snapshot (spec §8.1 invoices, FR-F01, FR-F02). Drafts are edited freely; issuing
// assigns the number and freezes customer, issuer, lines and totals (DB trigger). OVERDUE is
// derived from the due date and the open balance, never stored. Money is in minor units.
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  agencyId        String        @map("agency_id") @db.Uuid
  clientOrgId     String        @map("client_org_id") @db.Uuid
  projectId       String?       @map("project_id") @db.Uuid
  /// Agency-wide number, shown as INV-0001. Assigned on issue, so drafts never use one up.
  number          Int?
  status          InvoiceStatus @default(DRAFT)
  currency        String        @db.Char(3)
  taxRateBp       Int           @default(1400) @map("tax_rate_bp")
  dueOn           DateTime      @map("due_on") @db.Date
  issuedOn        DateTime?     @map("issued_on") @db.Date
  /// Client-visible payment terms or bank details text (no card data).
  terms           String?       @db.VarChar(2000)
  /// Internal only: never in the portal.
  internalNote    String?       @map("internal_note") @db.VarChar(2000)
  subtotalMinor   BigInt        @default(0) @map("subtotal_minor")
  taxMinor        BigInt        @default(0) @map("tax_minor")
  totalMinor      BigInt        @default(0) @map("total_minor")
  /// Sum of payments minus reversals, kept in the same transaction as each payment.
  paidMinor       BigInt        @default(0) @map("paid_minor")
  /// Snapshot of who is billed and who bills, fixed on issue (FR-F02).
  billedToName    String?       @map("billed_to_name") @db.VarChar(200)
  billedToContact String?       @map("billed_to_contact") @db.VarChar(200)
  issuerName      String?       @map("issuer_name") @db.VarChar(200)
  issuerDetails   String?       @map("issuer_details") @db.VarChar(1000)
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedById      String?       @map("issued_by_id") @db.Uuid
  /// When the client organization can see it in the portal.
  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(3)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedById      String?       @map("voided_by_id") @db.Uuid
  voidReason      String?       @map("void_reason") @db.VarChar(500)
  createdById     String        @map("created_by_id") @db.Uuid
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientOrg ClientOrganization @relation(fields: [agencyId, clientOrgId], references: [agencyId, id], onDelete: Restrict)
  /// Plain FK (nullable, ADR-025); the service checks the project's agency and client.
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy User               @relation("InvoicesCreated", fields: [agencyId, createdById], references: [agencyId, id], onDelete: Restrict)
  issuedBy  User?              @relation("InvoicesIssued", fields: [issuedById], references: [id], onDelete: Restrict)
  voidedBy  User?              @relation("InvoicesVoided", fields: [voidedById], references: [id], onDelete: Restrict)
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([agencyId, number])
  @@unique([agencyId, id])
  @@index([agencyId, status, dueOn])
  @@index([projectId])
  @@index([agencyId, clientOrgId])
  @@map("invoices")
}

// One line, priced exactly: quantity in hundredths, unit price excluding tax (spec §8.1 invoice_items).
model InvoiceItem {
  id             String            @id @default(uuid(7)) @db.Uuid
  invoiceId      String            @map("invoice_id") @db.Uuid
  position       Int
  description    String            @db.VarChar(500)
  quantityCenti  Int               @map("quantity_centi")
  unitPriceMinor BigInt            @map("unit_price_minor")
  lineTotalMinor BigInt            @map("line_total_minor")
  /// What the line bills for (spec J5 step 3: milestones or change orders).
  source         InvoiceLineSource @default(OTHER)
  sourceId       String?           @map("source_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_items")
}

// A confirmed manual payment or a reversal of one (spec §8.1 payments, FR-F03). Append-only.
model Payment {
  id           String        @id @default(uuid(7)) @db.Uuid
  agencyId     String        @map("agency_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  kind         PaymentKind   @default(PAYMENT)
  /// Always positive; a reversal subtracts its amount.
  amountMinor  BigInt        @map("amount_minor")
  currency     String        @db.Char(3)
  receivedOn   DateTime      @map("received_on") @db.Date
  method       PaymentMethod @default(BANK_TRANSFER)
  /// Bank or receipt reference. Never card numbers or bank credentials (SEC-14).
  reference    String?       @db.VarChar(120)
  note         String?       @db.VarChar(500)
  /// For a reversal: the payment it undoes (at most one reversal each).
  reversesId   String?       @unique @map("reverses_id") @db.Uuid
  recordedById String        @map("recorded_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice  @relation(fields: [agencyId, invoiceId], references: [agencyId, id], onDelete: Restrict)
  recordedBy User     @relation("PaymentsRecorded", fields: [agencyId, recordedById], references: [agencyId, id], onDelete: Restrict)
  reverses   Payment? @relation("PaymentReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy Payment? @relation("PaymentReversal")

  @@index([invoiceId, createdAt])
  @@index([agencyId, receivedOn])
  @@map("payments")
}

// An internal hourly cost rate for a person, from a date on (FR-F06). History is kept: a new
// rate starts a new row. Only Owner/Admin set rates; PMs never see them.
model CostRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  agencyId      String   @map("agency_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  hourlyMinor   BigInt   @map("hourly_minor")
  currency      String   @db.Char(3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  setById       String   @map("set_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User @relation("CostRates", fields: [agencyId, userId], references: [agencyId, id], onDelete: Restrict)
  setBy User @relation("CostRatesSet", fields: [agencyId, setById], references: [agencyId, id], onDelete: Restrict)

  @@unique([userId, effectiveFrom])
  @@index([agencyId, userId, effectiveFrom(sort: Desc)])
  @@map("cost_rates")
}

// M10: notifications, the job outbox and CSV imports.

/// What a notification is about. Users choose channels per category (FR-X09).
enum NotificationCategory {
  CLIENT_ACTIVITY
  APPROVALS
  TASKS
  FOLLOW_UPS
  INVOICES
}

// One message for one staff user (spec §8.1 notifications). Written in the same transaction as
// the event, so it cannot be lost or sent for a change that rolled back. Only the recipient reads it.
model Notification {
  id          String               @id @default(uuid(7)) @db.Uuid
  agencyId    String               @map("agency_id") @db.Uuid
  recipientId String               @map("recipient_id") @db.Uuid
  category    NotificationCategory
  /// Event name, e.g. "change.client_accepted" or "reminder.invoice_overdue".
  type        String               @db.VarChar(60)
  /// Plain text shown in the app only. Emails never include it (SEC-24).
  title       String               @db.VarChar(300)
  /// App path to open, always starting with /app/ (DB check). Built by the server, never from input.
  link        String               @db.VarChar(300)
  entityType  String?              @map("entity_type") @db.VarChar(40)
  entityId    String?              @map("entity_id") @db.Uuid
  actorId     String?              @map("actor_id") @db.Uuid
  /// Reminders use a key so a repeated scan never creates the same reminder twice.
  dedupeKey   String?              @map("dedupe_key") @db.VarChar(200)
  /// False when the user turned in-app off for the category but kept email on.
  inApp       Boolean              @default(true) @map("in_app")
  readAt      DateTime?            @map("read_at") @db.Timestamptz(3)
  emailedAt   DateTime?            @map("emailed_at") @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  recipient User   @relation("NotificationRecipient", fields: [agencyId, recipientId], references: [agencyId, id], onDelete: Restrict)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, inApp, createdAt(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

// A user's channel choice for one category. No row means the category default (ADR-059).
model NotificationPreference {
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  inApp     Boolean              @map("in_app")
  email     Boolean
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, category])
  @@map("notification_preferences")
}

enum JobState {
  PENDING
  RUNNING
  DONE
  DEAD
}

// Transactional outbox (spec §8.1 job_outbox, FR-A02). A job is written in the same transaction
// as the change that needs it; the worker claims jobs with SKIP LOCKED, retries with backoff and
// stops after max_attempts (dead letter). Payloads hold IDs only, never emails or tokens.
model OutboxJob {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String?   @map("agency_id") @db.Uuid
  kind        String    @db.VarChar(60)
  payload     Json
  state       JobState  @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  /// While RUNNING: when the claim expires. A worker that crashed loses the job after this.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Short error class and message, no payload or personal data.
  lastError   String?   @map("last_error") @db.VarChar(300)
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([state, availableAt])
  @@map("outbox_jobs")
}

// The record of a CSV import (FR-C10, FR-A07). The file itself is not kept: only its hash and the
// counts, so the import is auditable without storing a copy of the personal data.
model ImportRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  agencyId    String    @map("agency_id") @db.Uuid
  actorId     String    @map("actor_id") @db.Uuid
  /// "contacts" or "deals" (DB check).
  kind        String    @db.VarChar(20)
  filename    String?   @db.VarChar(200)
  fileSha256  String    @map("file_sha256") @db.Char(64)
  rowsTotal   Int       @map("rows_total")
  rowsCreated Int       @map("rows_created")
  rowsSkipped Int       @map("rows_skipped")
  rowsFailed  Int       @map("rows_failed")
  /// Set when the import was undone: its unchanged records were archived.
  undoneAt    DateTime? @map("undone_at") @db.Timestamptz(3)
  undoneById  String?   @map("undone_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  agency   Agency    @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actor    User      @relation("ImportRuns", fields: [agencyId, actorId], references: [agencyId, id], onDelete: Restrict)
  contacts Contact[]
  deals    Deal[]

  @@index([agencyId, createdAt(sort: Desc)])
  @@map("import_runs")
}
