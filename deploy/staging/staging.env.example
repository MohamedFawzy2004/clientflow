# Copy to deploy/staging/.env.staging (gitignored) and replace every value. Local staging only:
# never reuse these secrets for the demo or any hosted environment.
#
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
STAGING_PG_ADMIN_PASSWORD=
STAGING_APP_DB_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CSRF_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=
LOG_LEVEL=info
