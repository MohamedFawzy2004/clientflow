# Local staging only (docker-compose.staging.yml). Caddy issues a certificate for 127.0.0.1 from
# its internal CA; nothing here is reachable from outside this machine.
{
	http_port 8080
	https_port 8443
	# Clients send no server name (SNI) for an IP address, so pick the certificate by default.
	default_sni 127.0.0.1
	# The app sets its own security headers; Caddy only terminates TLS and forwards.
	servers {
		trusted_proxies static private_ranges
	}
}

https://127.0.0.1:8443 {
	tls internal
	reverse_proxy app:4000
}

http://127.0.0.1:8080 {
	redir https://127.0.0.1:8443{uri} permanent
}
