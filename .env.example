# Copy to .env and replace every placeholder. Never commit .env.
NODE_ENV=development

# Docker Postgres (docker-compose.yml). Use a long random password.
POSTGRES_USER=clientflow
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_PORT=5433

DATABASE_URL=postgresql://clientflow:change-me-to-a-long-random-value@127.0.0.1:5433/clientflow
TEST_DATABASE_URL=postgresql://clientflow:change-me-to-a-long-random-value@127.0.0.1:5433/clientflow_test
E2E_DATABASE_URL=postgresql://clientflow:change-me-to-a-long-random-value@127.0.0.1:5433/clientflow_e2e

# API
API_PORT=4000
# Comma-separated list of browser origins allowed to send state-changing requests.
APP_ORIGINS=http://localhost:5173
# At least 32 random characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
CSRF_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
# Set to the number of trusted reverse proxies in production (0 in local dev).
TRUST_PROXY=0

# Email (M2). dev-sink writes emails as JSON files under apps/api/.mail-sink (gitignored) and
# never sends them. disabled drops them. dev-sink is refused when NODE_ENV=production.
MAIL_TRANSPORT=dev-sink
MAIL_SINK_DIR=.mail-sink
# Base URL used in emailed links. Defaults to the first APP_ORIGINS entry.
# APP_PUBLIC_URL=https://app.example.com
